<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Settings"
             xmlns:wallets1="clr-namespace:WalletWasabi.Fluent.Models.Wallets"
             x:DataType="vm:WalletCoinJoinSettingsViewModel"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Settings.WalletCoinJoinSettingsView"
             x:CompileBindings="True">

  <StackPanel Classes="settingsLayout">
    <StackPanel Margin="0 0 0 20"
            Opacity="0.85"
            Spacing="40"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Classes="settingsLayout">
      <Button Theme="{StaticResource FunctionButton}"
              Height="37"
              Command="{Binding SelectMaximizePrivacySettings}"
              Classes.selected="{Binding MaximizePrivacyProfileSelected}"
              ToolTip.Tip="Repeats coinjoins to increase privacy, but costs additional fees.">
        <StackPanel Spacing="10" Orientation="Horizontal">
          <PathIcon Opacity="0.9" Foreground="{DynamicResource FunctionButtonForegroundColor}" Data="{StaticResource double_shield_regular}" />
          <TextBlock Margin="0 2 0 0" Text="Enhance Privacy" />
        </StackPanel>
      </Button>
      <Button Theme="{StaticResource FunctionButton}"
              Height="37"
              Command="{Binding SelectDefaultSettings}"
              Classes.selected="{Binding DefaultProfileSelected}"
              ToolTip.Tip="Balances privacy and cost.">
        <StackPanel Spacing="10" Orientation="Horizontal">
          <PathIcon Opacity="0.9" Foreground="{DynamicResource FunctionButtonForegroundColor}" Data="{StaticResource shield_regular}" />
          <TextBlock Margin="0 2 0 0" Text="Default Strategy" />
        </StackPanel>
      </Button>
      <Button Theme="{StaticResource FunctionButton}"
              Height="37"
              Command="{Binding SelectEconomicalSettings}"
              Classes.selected="{Binding EconomicalProfileSelected}"
              ToolTip.Tip="Minimizes transaction fees and allows non-private coin consolidation.">
        <StackPanel Spacing="10" Orientation="Horizontal">
          <PathIcon Opacity="0.9" Foreground="{DynamicResource FunctionButtonForegroundColor}" Data="{StaticResource coinjoin_cost}" />
          <TextBlock Margin="0 2 0 0" Text="Reduce Costs" />
        </StackPanel>
      </Button>
    </StackPanel>

    <DockPanel ToolTip.Tip="Each round can register at most one non-private coin.">
      <TextBlock Text="Non-private coin isolation" />
      <ToggleSwitch IsChecked="{Binding NonPrivateCoinIsolation}" Command="{Binding SetNonPrivateCoinIsolationCommand}" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Anonymity score target" ToolTip.Tip="Minimum anonymity score to consider a coin private." />
      <TextBox Classes="standalone" Name="AnonScoreTargetTextBox" Text="{Binding AnonScoreTarget}" DockPanel.Dock="Right" Watermark="Choose between 2 and 300." MaxLength="3" />
    </DockPanel>

    <Separator />

    <DockPanel>
      <TextBlock Text="Automatically start coinjoin" />
      <ToggleSwitch IsChecked="{Binding AutoCoinJoin}" Command="{Binding SetAutoCoinJoin}" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Coinjoin to this wallet:" />
      <ComboBox ItemsSource="{Binding Wallets}" IsEnabled="{Binding IsOutputWalletSelectionEnabled}"
                SelectedItem="{Binding SelectedOutputWallet}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="wallets1:IWalletModel">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <PathIcon DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0 2 7 0" Data="{StaticResource warning_regular}"
                Foreground="{DynamicResource WarningMessageForeground}" Height="17">
        <ToolTip.Tip>
          <TextBlock>
            - Only loaded wallets can be selected.<LineBreak />
            - Coins from the coinjoin transaction will be received by this wallet. However, this setting resets after Wasabi restarts.<LineBreak />
            - The selected wallet cannot be changed when a coinjoin is in progress.
          </TextBlock>
        </ToolTip.Tip>
      </PathIcon>
    </DockPanel>

    <DockPanel ToolTip.Tip="Coinjoin will automatically stop if the confirmed wallet balance is below this.">
      <TextBlock Text="Stop coinjoin threshold" />
      <CurrencyEntryBox Classes="standalone" Text="{Binding PlebStopThreshold}" CurrencyCode="BTC" />
    </DockPanel>

    <Separator IsVisible="{Binding IsHardwareCoinJoinWallet}" />

    <TextBlock IsVisible="{Binding IsHardwareCoinJoinWallet}"
               Text="{Binding CoinJoinLimitsEnforcedBy}"
               TextWrapping="Wrap" Opacity="0.6" Margin="0,4,0,0" />

    <DockPanel IsVisible="{Binding IsHardwareCoinJoinWallet}"
               ToolTip.Tip="The maximum number of coinjoin rounds a single hardware wallet authorization covers. Once used up, the device must authorize again.">
      <TextBlock Text="Max coinjoin rounds per authorization" />
      <TextBox Classes="standalone" Text="{Binding TrezorMaxRounds}" DockPanel.Dock="Right" Watermark="1 to 500" MaxLength="3" />
    </DockPanel>

    <DockPanel IsVisible="{Binding IsHardwareCoinJoinWallet}"
               ToolTip.Tip="Rounds above this rate are skipped, so a coinjoin never overpays. Set it too low and rounds are skipped whenever the network is busy. Around 5 is already high for a coinjoin; coordinators currently set 0.5 at the lowest. On a Coldcard the device enforces this as well, which is what makes it hold against a compromised computer — and there it prices everything you lose in a round, so a coordinator fee counts toward it alongside the mining fee.">
      <TextBlock Text="Max fee rate (sat/vByte)" />
      <TextBox Classes="standalone" Text="{Binding TrezorMaxMiningFeeRate}" DockPanel.Dock="Right" Watermark="e.g. 5" MaxLength="6" />
    </DockPanel>

    <!--
      No self-transfer percentage here on purpose. It is fixed at 50% in ColdcardHsmPolicy as a sanity
      floor behind the fee rate limit above, which is the number that actually decides rounds. A ratio
      refuses honest rounds on small coins at a threshold that moves with the network, so exposing it
      invited exactly the confusion this screen should not create.
    -->

    <DockPanel IsVisible="{Binding IsColdcardCoinJoinWallet}"
               ToolTip.Tip="The most of your own value the device will let leave in one transaction — your share of the mining fee, plus anything lost. This is the limit that protects a large wallet, where a percentage would allow far more than you would accept. Raise it only if rounds are refused at realistic fee rates.">
      <TextBlock Text="Max value leaving per transaction (sats)" />
      <TextBox Classes="standalone" Text="{Binding ColdcardMaxSatsLeaving}" DockPanel.Dock="Right" Watermark="100000" MaxLength="9" />
    </DockPanel>

    <DockPanel IsVisible="{Binding IsColdcardCoinJoinWallet}"
               ToolTip.Tip="How many transactions the device will sign per hour. Every round costs you a fee share even when the coinjoin is honest, so this bounds how fast a coordinator proposing rounds back to back can farm those fees. The total budget above bounds the session; this bounds the burst.">
      <TextBlock Text="Max transactions per hour" />
      <TextBox Classes="standalone" Text="{Binding ColdcardMaxTxnPerPeriod}" DockPanel.Dock="Right" Watermark="6" MaxLength="3" />
    </DockPanel>

    <DockPanel IsVisible="{Binding IsColdcardCoinJoinWallet}"
               ToolTip.Tip="The fewest participants' inputs a round may have before the Coldcard will sign it — everyone's, not just yours. Wasabi has its own minimum, but Wasabi is what picks the round, so only the device can enforce this against a compromised computer. It rules out a round with nobody in it but you; it is not an anonymity set, since a coordinator can pad a round with its own inputs. 0 turns it off.">
      <TextBlock Text="Minimum inputs in a round" />
      <TextBox Classes="standalone" Text="{Binding ColdcardMinInputs}" DockPanel.Dock="Right" Watermark="21" MaxLength="5" />
    </DockPanel>

    <!--
      HSM mode cannot be changed while it runs, which is the point of it: a host able to end it could
      also drop every limit above. So a value edited after the device was locked in is saved here and
      simply not applied. Coinjoin refuses later anyway, but by then the reason is far from the cause.
    -->
    <StackPanel IsVisible="{Binding ColdcardPolicyOutOfSync}" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
      <PathIcon Data="{StaticResource warning_regular}" Height="15"
                Foreground="{DynamicResource WarningMessageForeground}" VerticalAlignment="Top" />
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningMessageForeground}"
                 Text="These limits are not the ones the Coldcard is enforcing. Reboot the device and start coinjoin to approve them." />
    </StackPanel>

    <!--
      What the device reports it is enforcing, in its own words, next to the settings above. The device
      is what actually refuses a transaction, so its account of the rules is the one that counts; the
      hash is there to be compared with the one shown on the Coldcard screen when the policy was approved.
      Hidden until a policy has been accepted.
    -->
    <StackPanel IsVisible="{Binding DevicePolicySummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Spacing="4" Margin="0,10,0,0">
      <Separator />
      <TextBlock Text="Policy active on the device" FontWeight="Bold" />
      <TextBlock Text="{Binding DevicePolicySummary}" TextWrapping="Wrap" Opacity="0.75"
                 FontFamily="{StaticResource MonospacedFont}" FontSize="11" />
      <DockPanel ToolTip.Tip="The Coldcard showed this hash when it accepted the policy. If it matches, the device is enforcing exactly the policy that was sent to it.">
        <TextBlock Text="Policy hash" />
        <SelectableTextBlock Text="{Binding DevicePolicyHash}" DockPanel.Dock="Right"
                             TextWrapping="Wrap" Opacity="0.75" FontSize="11" />
      </DockPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
